<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- La vue JavaFX garde des références vers le modèle, c'est voulu -->
  <Match>
    <Package name="~latice\.javaFx\..*"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Choix de conception : le controleur modifie directement le rack du joueur -->
  <Match>
    <Class name="latice.model.Player"/>
    <Method name="getRack"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
